<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Test Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Test Dashboard">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
  </head>

  <body class="flex min-h-screen">
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-900">Admin Panel</h2>
        <p class="text-sm text-gray-500 mt-1"><%= current_user.name %></p>
      </div>

      <nav class="p-4 flex-1 space-y-1">
        <% nav_items = [
          { label: "Dashboard", path: admin_root_path, active: request.path == "/admin" || request.path == "/admin/dashboard" },
          { label: "Users", path: admin_users_path, active: request.path.start_with?("/admin/users") }
        ] %>
        <% nav_items.each do |item| %>
          <%= link_to item[:label], item[:path], class: "block px-3 py-2 rounded-lg text-sm font-medium #{item[:active] ? 'bg-indigo-50 text-indigo-600' : 'text-gray-700 hover:bg-gray-50'}" %>
        <% end %>
      </nav>

      <div class="p-4 border-t border-gray-200 space-y-2">
        <%= link_to "Back to Dashboard", dashboard_path, class: "block px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 cursor-pointer" %>
      </div>
    </aside>

    <main class="flex-1 p-8 bg-gray-50">
      <div id="admin_notifications_stream" data-turbo-permanent>
        <%= turbo_stream_from "admin_notifications" %>
      </div>

      <% if flash[:notice] %>
        <div class="mb-6 rounded-lg bg-green-50 p-4 text-sm text-green-700"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-700"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </main>

    <div id="admin_toast_container" class="fixed top-4 right-4 z-50 flex flex-col gap-3"></div>
  </body>
</html>
