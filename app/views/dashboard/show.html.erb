<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
      <%= render "shared/flash" %>

      <h1 class="text-2xl font-bold text-gray-900">Welcome, <%= current_user.name %>!</h1>

      <div class="mt-8">
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
