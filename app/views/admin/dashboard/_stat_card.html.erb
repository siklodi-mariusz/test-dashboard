<% gradient = local_assigns[:variant] == :gradient %>
<div class="<%= gradient ? 'bg-gradient-to-br from-pink-200 via-purple-300 to-indigo-400' : 'bg-white border border-gray-200' %> rounded-lg overflow-hidden p-6 flex flex-col gap-8 min-h-[152px]">
  <p class="text-sm font-semibold <%= gradient ? 'text-white' : 'text-gray-700' %>">
    <%= title %>
  </p>

  <div class="flex flex-col gap-1">
    <p class="text-2xl font-semibold <%= gradient ? 'text-white' : 'text-gray-900' %>">
      <%= count %>
    </p>

    <% if local_assigns[:change] %>
      <div class="flex items-center gap-1.5">
        <span class="text-xs <%= gradient ? 'text-white' : 'text-gray-500' %>">vs previous period</span>

        <% if change > 0 %>
          <span class="inline-flex items-center gap-1 bg-green-50 text-green-600 text-xs font-semibold px-1.5 py-0.5 rounded-full">
            <svg class="size-1.5" viewBox="0 0 6 5" fill="currentColor"><polygon points="3,0 6,5 0,5"/></svg>
            <%= change %>%
          </span>
        <% elsif change < 0 %>
          <span class="inline-flex items-center gap-1 bg-red-50 text-red-500 text-xs font-semibold px-1.5 py-0.5 rounded-full">
            <svg class="size-1.5" viewBox="0 0 6 5" fill="currentColor"><polygon points="0,0 6,0 3,5"/></svg>
            <%= change.abs %>%
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-500 text-xs font-semibold px-1.5 py-0.5 rounded-full">
            0%
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
