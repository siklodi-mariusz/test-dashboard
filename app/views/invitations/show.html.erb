<div class="min-h-screen bg-gray-50 flex items-center justify-center">
  <div class="w-full max-w-md mx-auto flex flex-col gap-8 py-16 px-4">
    <div class="flex flex-col items-center gap-2">
      <div class="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      </div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Test Dashboard</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 flex flex-col gap-6">
      <div>
        <h1 class="text-xl font-bold text-gray-900">You've been invited!</h1>
        <p class="text-sm text-gray-500 mt-1"><%= @invitation.invited_by.name %> has invited you to join Test Dashboard. Set up your account below.</p>
      </div>

      <% if @user.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with(model: @user, url: invitation_path(token: @invitation.token), method: :patch, class: "flex flex-col gap-4") do |f| %>
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-gray-700">Email address</label>
          <div class="relative">
            <input type="email" value="<%= @invitation.email %>" readonly class="w-full px-3 py-2 pr-9 border border-gray-200 rounded-lg text-sm text-gray-500 bg-gray-50 cursor-not-allowed" />
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <p class="text-xs text-gray-400">Your email is pre-filled and cannot be changed.</p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-gray-700">Full name <span class="text-red-500">*</span></label>
          <%= f.text_field :name, placeholder: "Your full name", class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-gray-700">Password <span class="text-red-500">*</span></label>
          <%= f.password_field :password, placeholder: "Min. 6 characters", class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-gray-700">Confirm password <span class="text-red-500">*</span></label>
          <%= f.password_field :password_confirmation, placeholder: "Repeat your password", class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <%= f.submit "Create My Account", class: "w-full px-4 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 mt-1 cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-center text-xs text-gray-400">This invitation expires 72 hours after it was sent.</p>
  </div>
</div>
