# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
/storage/*
!/log/.keep
!/tmp/.keep
!/storage/.keep

# Ignore compiled assets.
app/assets/builds/*
!app/assets/builds/.keep

# Ignore prototype files.
public/prototypes/*
!public/prototypes/.keep

# Ignore local Claude Code settings (personal per developer).
.claude/settings.local.json

# Ignore Claude Code plans (working documents, not source code).
.claude/plans/*
!.claude/plans/.keep
