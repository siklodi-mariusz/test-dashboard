<div class="min-h-screen bg-gray-50 flex items-center justify-center">
  <div class="w-full max-w-md mx-auto flex flex-col items-center gap-8 text-center px-6 py-16">
    <div class="w-16 h-16 bg-yellow-100 rounded-2xl flex items-center justify-center">
      <svg class="w-8 h-8 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="flex flex-col gap-2">
      <h1 class="text-xl font-bold text-gray-900">Invitation Expired</h1>
      <p class="text-sm text-gray-500 leading-relaxed">This invitation link has expired. Invitation links are valid for 72 hours after they are sent.</p>
      <p class="text-sm text-gray-500 leading-relaxed mt-1">Please contact your admin to request a new invitation.</p>
    </div>
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-left w-full">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Invited email</p>
      <p class="text-sm text-gray-700"><%= @invitation.email %></p>
    </div>
    <%= link_to "← Back to sign in", new_user_session_path, class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
  </div>
</div>
