<div data-controller="toast"
     class="w-80 bg-white border border-gray-200 rounded-lg shadow-lg p-4 flex items-start gap-3 transition-all duration-300 ease-in-out translate-x-full opacity-0">
  <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-sm font-medium text-gray-900">New user signed up</p>
    <p class="text-sm text-gray-500 truncate"><%= user.name %> &mdash; <%= user.email %></p>
  </div>
  <button data-action="toast#dismiss" class="flex-shrink-0 text-gray-400 hover:text-gray-600 cursor-pointer">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
</div>
